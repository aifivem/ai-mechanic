{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ai-mechanic/data/shops.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "This file's JSON Schema (for editors)."
    }
  },
  "patternProperties": {
    "^[a-z0-9_]{2,32}$": {
      "type": "object",
      "properties": {
        "ped": {
          "type": "object",
          "properties": {
            "model": {
              "description": "Model: The ped model; empty means no NPC. Players see it within 50 m.",
              "type": "string",
              "maxLength": 64
            },
            "scenario": {
              "description": "What it does: An idle animation the NPC plays on the spot.",
              "enum": [
                "",
                "WORLD_HUMAN_STAND_IMPATIENT",
                "WORLD_HUMAN_CLIPBOARD",
                "WORLD_HUMAN_STAND_MOBILE",
                "WORLD_HUMAN_AA_COFFEE",
                "WORLD_HUMAN_SMOKING",
                "WORLD_HUMAN_GUARD_STAND",
                "WORLD_HUMAN_COP_IDLES",
                "WORLD_HUMAN_HANG_OUT_STREET"
              ]
            },
            "coords": {
              "description": "Where it stands: The NPC's floor spot and the way it faces (scroll in the free camera); without one it stands on the place's point.",
              "type": "object",
              "required": [
                "x",
                "y",
                "z",
                "heading"
              ],
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                },
                "heading": {
                  "type": "number"
                }
              }
            }
          },
          "required": []
        },
        "label": {
          "description": "Name",
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "job": {
          "description": "Job: Empty: a public shop, the driver pays.",
          "type": "string",
          "minLength": 0,
          "maxLength": 32
        },
        "coords": {
          "description": "Place: The middle of the workshop floor.",
          "type": "object",
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        },
        "radius": {
          "description": "Area size: How far from the place a vehicle can be served.",
          "type": "number",
          "minimum": 2,
          "maximum": 40
        },
        "blip": {
          "description": "Show on the map",
          "type": "boolean"
        },
        "repair": {
          "description": "Repairs: Fixes engine and body; the price follows the damage.",
          "type": "boolean"
        },
        "tuning": {
          "description": "Tuning: Performance, body parts, wheels, paint, tint, plate and lights.",
          "type": "boolean"
        },
        "multiplier": {
          "description": "Price multiplier: Every price here is multiplied by this (1 = the prices in Settings).",
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "stash": {
          "description": "Stash: A shared stash for the job's members. Leave at 0, 0, 0 for none.",
          "type": "object",
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        }
      },
      "required": [
        "label",
        "job",
        "coords",
        "radius",
        "blip",
        "repair",
        "tuning",
        "multiplier",
        "stash"
      ]
    }
  },
  "additionalProperties": false
}
